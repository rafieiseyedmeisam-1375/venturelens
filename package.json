{
  "name": "venturelens",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:rtl": "node scripts/rtl-smoke-check.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:all": "npm run lint && npm run lint:rtl && npm run typecheck && npm run format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "db:up": "node scripts/local-postgres.mjs",
    "db:up:docker": "docker compose up -d db",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/migrate.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "worker:dev": "tsx --env-file=.env src/worker/main.ts",
    "worker:build": "tsc -p tsconfig.worker.json",
    "worker:start": "node dist/worker/main.js",
    "build:all": "npm run db:generate && npm run build && npm run worker:build",
    "dev:preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "5.3.0",
