# Local development. Production uses Supabase session pooling.
DATABASE_URL=postgresql://venturelens:local-development-only@127.0.0.1:5432/venturelens?schema=venturelens&connection_limit=2
MIGRATION_DATABASE_URL=postgresql://venturelens:local-development-only@127.0.0.1:5432/venturelens?schema=venturelens
APP_ORIGIN=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1
LOG_LEVEL=info
PRISMA_LOG_QUERIES=false
SESSION_MAX_AGE_DAYS=0.5
# Explicit local preview only; production rejects true.
SKIP_AUTH=false
# No default administrator. Set these privately before db:seed.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=

# Supabase: dashboard SESSION pooler, port 5432, separate runtime and migration roles.
# DATABASE_URL=postgresql://ROLE.PROJECT:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?schema=venturelens&connection_limit=2&sslmode=require
# MIGRATION_DATABASE_URL=postgresql://MIGRATOR.PROJECT:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?schema=venturelens&sslmode=require
# Verify TLS certificates. Never disable verification.
# Planned integrations; not yet implemented:
# SUPABASE_PROJECT_REF=
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=originals
# S3_ARTIFACT_BUCKET=artifacts
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# AI_API_KEY=  # worker only; never NEXT_PUBLIC
